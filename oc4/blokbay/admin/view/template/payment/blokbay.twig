{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_intro }}</div>
    {% if currency_warning %}<div class="alert alert-warning" id="blokbay-currency-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ currency_warning }}</div>{% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-secret-key" class="col-sm-2 col-form-label">{{ entry_secret_key }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_blokbay_secret_key" value="{{ payment_blokbay_secret_key }}" placeholder="sk_live_..." id="input-secret-key" class="form-control" autocomplete="off"/>
              <div id="error-secret-key" class="invalid-feedback"></div>
              <div class="form-text">{{ help_secret_key }}</div>
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-webhook-secret" class="col-sm-2 col-form-label">{{ entry_webhook_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_blokbay_webhook_secret" value="{{ payment_blokbay_webhook_secret }}" placeholder="whsec_..." id="input-webhook-secret" class="form-control" autocomplete="off"/>
              <div id="error-webhook-secret" class="invalid-feedback"></div>
              <div class="form-text">{{ help_webhook }}</div>
              <input type="text" readonly value="{{ webhook_url }}" class="form-control mt-1" id="input-webhook-url"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-public-key" class="col-sm-2 col-form-label">{{ entry_public_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_blokbay_public_key" value="{{ payment_blokbay_public_key }}" placeholder="pk_live_..." id="input-public-key" class="form-control"/>
              <div class="form-text">{{ help_public_key }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-pending-status" class="col-sm-2 col-form-label">{{ entry_pending_status }}</label>
            <div class="col-sm-10">
              <select name="payment_blokbay_pending_status_id" id="input-pending-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_blokbay_pending_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-paid-status" class="col-sm-2 col-form-label">{{ entry_paid_status }}</label>
            <div class="col-sm-10">
              <select name="payment_blokbay_paid_status_id" id="input-paid-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_blokbay_paid_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-expired-status" class="col-sm-2 col-form-label">{{ entry_expired_status }}</label>
            <div class="col-sm-10">
              <select name="payment_blokbay_expired_status_id" id="input-expired-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_blokbay_expired_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-base" class="col-sm-2 col-form-label">{{ entry_api_base }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_blokbay_api_base" value="{{ payment_blokbay_api_base }}" id="input-api-base" class="form-control"/>
              <div id="error-api-base" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_blokbay_status" value="0"/>
                <input type="checkbox" name="payment_blokbay_status" value="1" id="input-status" class="form-check-input"{% if payment_blokbay_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_blokbay_sort_order" value="{{ payment_blokbay_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
