{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_intro }}</div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-secret-key">{{ entry_secret_key }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_blokbay_secret_key" value="{{ payment_blokbay_secret_key }}" placeholder="sk_live_..." id="input-secret-key" class="form-control" autocomplete="off" />
              {% if error_secret_key %}<div class="text-danger">{{ error_secret_key }}</div>{% endif %}
              <span class="help-block">{{ help_secret_key }}</span>
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-webhook-secret">{{ entry_webhook_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_blokbay_webhook_secret" value="{{ payment_blokbay_webhook_secret }}" placeholder="whsec_..." id="input-webhook-secret" class="form-control" autocomplete="off" />
              {% if error_webhook_secret %}<div class="text-danger">{{ error_webhook_secret }}</div>{% endif %}
              <span class="help-block">{{ help_webhook }}</span>
              <input type="text" readonly value="{{ webhook_url }}" class="form-control" id="input-webhook-url" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-public-key">{{ entry_public_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_blokbay_public_key" value="{{ payment_blokbay_public_key }}" placeholder="pk_live_..." id="input-public-key" class="form-control" />
              <span class="help-block">{{ help_public_key }}</span>
            </div>
          </div>
          {% for field in [['pending_status_id', entry_pending_status, payment_blokbay_pending_status_id], ['paid_status_id', entry_paid_status, payment_blokbay_paid_status_id], ['expired_status_id', entry_expired_status, payment_blokbay_expired_status_id]] %}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-{{ field[0] }}">{{ field[1] }}</label>
            <div class="col-sm-10">
              <select name="payment_blokbay_{{ field[0] }}" id="input-{{ field[0] }}" class="form-control">
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == field[2] %} selected="selected"{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          {% endfor %}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-base">{{ entry_api_base }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_blokbay_api_base" value="{{ payment_blokbay_api_base }}" id="input-api-base" class="form-control" />
              {% if error_api_base %}<div class="text-danger">{{ error_api_base }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="payment_blokbay_status" id="input-status" class="form-control">
                <option value="1"{% if payment_blokbay_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not payment_blokbay_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_blokbay_sort_order" value="{{ payment_blokbay_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
